# Copie este arquivo para ".env" (na mesma pasta) e preencha.
# O arquivo .env NÃO vai para o GitHub: ele está no .gitignore.

# Chave do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcional: outro modelo do Gemini
GEMINI_MODELO=gemini-3.5-flash-lite

# Robô do Telegram: o token vem do @BotFather
TELEGRAM_BOT_TOKEN=
# Preenchido sozinho por: python -m nossovoto.enviar --descobrir-chat
TELEGRAM_CHAT_ID=

# Instagram: token gerado no painel da Meta (vale 60 dias)
INSTAGRAM_ACCESS_TOKEN=
# Preenchido sozinho por: python -m nossovoto.instagram --verificar
INSTAGRAM_USER_ID=
